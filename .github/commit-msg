
set -euo pipefail

commit_msg_file="$1"
first_line="$(head -n1 "$commit_msg_file")"

if [[ "$first_line" =~ ^(Merge\ |Revert\ \") ]]; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore)(\([a-zA-Z0-9_.-]+\))?!?: .{1,88}$'

if [[ ! "$first_line" =~ $pattern ]]; then
  echo "commit-msg hook: rejected - message doesn't follow Conventional Commits" >&2
  echo "  got:      $first_line" >&2
  echo "  expected: <type>(<scope>): <subject>" >&2
  echo "  types:    feat fix docs style refactor perf test build ci chore" >&2
  echo "  example:  feat(handler): add health check endpoint" >&2
  exit 1
fi

exit 0
